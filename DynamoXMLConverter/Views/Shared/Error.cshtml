@using DynamoXMLConverter.Domain.Models.Http
@model HttpErrorResponse;
@{
    ViewData["Title"] = "Error";
}

<div class="error-holder-section">
    <div class="header-text">
        <span class="text-danger">An error occurred while processing your request.</span>
    </div>

    <div class="article">
        <div class="article-header">
            <div class="home-button-holder">
                <a formmethod="get" asp-controller="Home" asp-action="Index">Home page</a>
            </div>
        </div>

        <div class="article-body">
            @if (!string.IsNullOrEmpty(Model.Message))
            {
                <div>
                    <strong>Message:</strong> <code>@Model.Message</code>
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.Code))
            {
                <div>
                    <strong>Status code:</strong> <code>@Model.Code</code>
                </div>
            }
        </div>
    </div>
</div>
